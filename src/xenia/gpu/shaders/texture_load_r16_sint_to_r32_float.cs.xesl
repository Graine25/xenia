#include "texture_load_integer_sint.xesli"

XE_TEXTURE_LOAD_ENTRY(16) {
  // 1 thread = 4 blocks
  // 4 x R16 16bpb -> 4 x R32_FLOAT
  XeTextureLoadInfo load_info = XeTextureLoadGetInfo(pass_push_consts_xe);
  uint3_xe block_index = in_global_thread_id_xe << uint3_xe(2u, 0u, 0u);
  dont_flatten_xe if (any(greater_than_equal_xe(block_index.xy,
                                                load_info.size_blocks.xy))) {
    return;
  }
  uint block_offset_host =
      load_info.host_offset +
      uint(XeTextureHostLinearOffset(int3_xe(block_index), load_info.host_pitch,
                                     load_info.size_blocks.y, 4u));
  uint block_offset_guest =
      XeTextureLoadSourceAddress(load_info, block_index, 1u);
  uint4_xe guest = XeEndianSwap16(
      byte_buffer_align16_load16_xe(xe_texture_load_source, block_offset_guest),
      load_info.endian_32);
  // guest.x: block0 in [15:0], block1 in [31:16]
  // guest.y: block2 in [15:0], block3 in [31:16]
  uint4_xe expanded;
  expanded.x = float_bits_to_uint_xe(XeIntegerS16ToFloat(guest.x & 0xFFFFu));
  expanded.y = float_bits_to_uint_xe(XeIntegerS16ToFloat(guest.x >> 16u));
  expanded.z = float_bits_to_uint_xe(XeIntegerS16ToFloat(guest.y & 0xFFFFu));
  expanded.w = float_bits_to_uint_xe(XeIntegerS16ToFloat(guest.y >> 16u));
  byte_buffer_align16_store16_xe(xe_texture_load_dest, block_offset_host,
                                 expanded);
}
entry_code_end_compute_xe